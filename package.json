{
  "name": "ls-orcamento",
  "version": "1.0.0",
  "description": "Sistema de Orçamento LS",
  "main": "src/backend/server.ts",
  "scripts": {
    "start": "concurrently --kill-others \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "vite",
    "start:backend": "tsx -r dotenv/config src/backend/server.ts",
    "deploy": "prisma db push --skip-generate && prisma generate",
    "seed": "tsx -r dotenv/config src/backend/seed.ts",
    "redefinir-senha": "tsx -r dotenv/config src/backend/scripts/redefinir-senha.ts",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch src/backend/server.ts",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "vite build",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build": "npm run build:frontend && npm run build:backend",
    "typecheck": "tsc --noEmit --project tsconfig.backend.json",
    "test": "tsx src/backend/scripts/rodar-validacoes.ts"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@tutao/oxmsg": "^0.0.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "fuzzball": "^2.2.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "5.4.624",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.7.0",
    "tailwind-merge": "^2.2.1",
    "uuid": "^13.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "prisma": "^5.10.2",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@tutao/oxmsg": {
      "uuid": "^11.1.1"
    }
  }
}
