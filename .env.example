# Copie para .env e preencha. O .env nunca vai para o repositório.

PORT=3001
DATABASE_URL="file:./dev.db"

# Chave que assina o login. Obrigatória: sem ela o servidor não sobe.
# Gere uma longa e aleatória, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Opcional: endereços públicos aceitos pelo CORS (ex.: túnel Cloudflare), separados por vírgula.
# PUBLIC_ORIGINS=https://lsi.exemplo.com.br
# FRONTEND_URL=
