node_modules/
dist/
output/
build/
.env
.env.*
!.env.example
.DS_Store
coverage/
*.log
.tmp/

# Arquivos operacionais e artefatos gerados localmente
storage/
outputs/
generated.pdf

# Banco de dados local (contém dados sensíveis)
# O glob cobre qualquer dump solto na pasta, não só o dev.db — um backup
# nomeado à mão já ficou fora do ignore e quase entrou num commit.
prisma/*.db
prisma/*.db-journal
# Backup com sufixo depois do .db (ex.: dev.db.bak-antes-sites-20261003).
prisma/*.db.*
*.db.bak*
prisma/backups/

# Pastas de backup e cópias anteriores à restauração
backup-*/
antes-restauracao-*/

# Logs de servidor
ls-backend.log
ls-frontend.log
.claude/settings.local.json

# E-mails gerados (.eml) — carregam CPF, chave PIX, dados bancarios do
# favorecido e a assinatura pessoal de quem gerou. Nao entram no repositorio.
*.eml
